# ─── Al-Rifai ERP + Data Game — copy to .env and fill real values. NEVER commit .env ───
# Supabase: Project Settings → Database → Connection string (URI). Use the SESSION pooler (port 5432).
DATABASE_URL=postgresql://postgres.<project-ref>:<DB-PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
DATABASE_POOL_SIZE=10

# ≥ 32 random chars:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=5000
NODE_ENV=production
ALLOWED_ORIGINS=
# Public base URL of the server (used to build full image URLs). Optional behind a proxy.
BASE_URL=

# Optional ERP notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Data Game (all optional; defaults shown) ───
GAME_LEASE_SECONDS=300
GAME_SKIP_COOLDOWN_HOURS=12
GAME_DAILY_GOAL=25
GAME_TIMEZONE=Africa/Cairo
GAME_DATA_ROLES=admin,manager,sales,warehouse
GAME_INVENTORY_ROLES=admin,manager,warehouse
